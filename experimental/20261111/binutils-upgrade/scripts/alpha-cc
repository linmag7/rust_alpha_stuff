#!/usr/bin/env python3
import os,sys
from pathlib import Path
w=Path(__file__).resolve().parent
p=w.parent.parent
sdk=p/'work/sdk/release/alpha-sdk'
e=os.environ.copy()
e['GCC_EXEC_PREFIX']=str(sdk/'gcc/lib/gcc')+'/'
e['COMPILER_PATH']=os.pathsep.join(map(str,[w/'install/alphaev6-unknown-linux-gnu/bin',sdk/'gcc/libexec/gcc/alphaev6-unknown-linux-gnu/16.0.0']))
e['TMPDIR']=str(w/'tmp')
cc=sdk/'gcc/bin/alphaev6-unknown-linux-gnu-gcc'
os.execve(cc,[str(cc),'--sysroot='+str(sdk/'sysroot'),'-B'+str(w/'install/alphaev6-unknown-linux-gnu/bin')+'/',*sys.argv[1:]],e)
