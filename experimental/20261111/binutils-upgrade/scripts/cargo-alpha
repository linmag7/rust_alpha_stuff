#!/usr/bin/env python3
import json,os,shlex,sys
from pathlib import Path
w=Path(__file__).resolve().parent
p=w.parent.parent
sdk=p/'work/sdk/release/alpha-sdk'
binutils=p/'work/binutils-20261111'
cc=binutils/'alpha-cc'
ar=binutils/'install/bin/alphaev6-unknown-linux-gnu-ar'
build_id=(w/'toolchain-id').read_text().strip()
stage=w/'rust-build/x86_64-unknown-linux-gnu/stage2'
e=os.environ.copy()
e.update(TMPDIR=str(w/'tmp'),CARGO_HOME=str(w/'cargo-home'),CARGO_TARGET_DIR=str(w/'target'/build_id),
    RUSTC=str(stage/'bin/rustc'),RUSTC_BOOTSTRAP='1',CARGO_INCREMENTAL='0',
    LD_LIBRARY_PATH=str(stage/'lib'),
    CG_GCCJIT_LIBRARY_PATH=str(p/'work/rebase-20261111/build/gcc/gcc/libgccjit.so'),
    ALPHA_CC=str(cc),ALPHA_AR=str(ar),ALPHA_SYSROOT=str(sdk/'sysroot'))
e['ALPHA_CACHE_DIR']=str(w/'sdk-cache')
for suffix in ('alphaev6-unknown-linux-gnu','alphaev6_unknown_linux_gnu'):
    e['CC_'+suffix]=str(cc)
    e['AR_'+suffix]=str(ar)
e['PATH']=os.pathsep.join([str(binutils/'install/bin'),str(sdk/'gcc/bin'),e['PATH']])
flags=['-Zcodegen-backend='+str(w/'backend-target/release/librustc_codegen_gcc.so'),
       '-C','linker='+str(cc),'-C','panic=abort','-C','lto=off']
no_std=e.get('ALPHA_NO_STD') == '1'
if no_std:
    flags += ['-C','link-arg=-nostdlib','-C','link-arg=-nostartfiles','-C','link-arg=-lc']
flags+=shlex.split(e.pop('RUSTFLAGS',''))
e['CARGO_ENCODED_RUSTFLAGS']='\x1f'.join(flags)
args=sys.argv[1:]
operation=args.pop(0) if args else 'build'
if operation == 'test':
    e['ALPHA_TEST']='1'
    e['CARGO_ENCODED_RUSTFLAGS'] += '\x1f-Zpanic-abort-tests'
    args=['-Zpanic-abort-tests',*args]
    if not any(a.split('=')[0] in ('--lib','--bins','--bin','--tests','--test','--all-targets') for a in args):
        args=['--tests',*args]
cmd=[str(w/'rust-build/x86_64-unknown-linux-gnu/stage0/bin/cargo'),operation,
     '--target','alphaev6-unknown-linux-gnu',
     '-Zbuild-std='+('core,alloc' if no_std else 'std,panic_abort'+(',test' if operation == 'test' else '')),
     '-Zbuild-std-features=',
     '--config','patch.crates-io.libc.path='+json.dumps(str(w/'libc')),
     '--config','target.alphaev6-unknown-linux-gnu.runner='+json.dumps([str(sdk/'bin/alpha-runner')]),*args]
os.execve(cmd[0],cmd,e)
