+fn ctest_shard(cfg: &mut ctest::TestGenerator) {
+    let Ok(value) = env::var("LIBC_CI_CTEST_SHARD") else {
+        return;
+    };
+    let (index, count) = value.split_once('/').expect("expected shard index/count");
+    let index: u64 = index.parse().expect("invalid shard index");
+    let count: u64 = count.parse().expect("invalid shard count");
+    assert!(count > 0 && index < count);
+    let excluded = move |name: &str| {
+        name.bytes().fold(0u64, |hash, byte| {
+            hash.wrapping_mul(31).wrapping_add(u64::from(byte))
+        }) % count
+            != index
+    };
+    cfg.skip_alias(move |item| excluded(item.ident()))
+        .skip_const(move |item| excluded(item.ident()))
+        .skip_struct(move |item| excluded(item.ident()))
+        .skip_union(move |item| excluded(item.ident()))
+        .skip_fn(move |item| excluded(item.ident()))
+        .skip_static(move |item| excluded(item.ident()));
+}
